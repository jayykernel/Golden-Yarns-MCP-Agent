// Prisma schema for Golden Yarns MCP Agent
// This schema defines the core business entities for yarn inventory management

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Yarn type classification (e.g., Cotton, Wool, Silk, etc.)
model YarnType {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

// Yarn count/thickness (e.g., 20s, 30s, 40s)
model YarnCount {
  id        Int      @id @default(autoincrement())
  value     String   @unique // e.g., "20s", "30s", "40s"
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([value])
}

// Color of the yarn
model Color {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  code      String?  // Hex code or color code
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}
