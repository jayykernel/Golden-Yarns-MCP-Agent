// Prisma schema for Golden Yarns MCP Agent
// This schema defines the core business entities for yarn inventory management

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Yarn type classification (e.g., Cotton, Wool, Silk, etc.)
model YarnType {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relation to stock lots
  lots      StockLot[]

  @@index([name])
}

// Yarn count/thickness (e.g., 20s, 30s, 40s)
model YarnCount {
  id        Int      @id @default(autoincrement())
  value     String   @unique // e.g., "20s", "30s", "40s"
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relation to stock lots
  lots      StockLot[]

  @@index([value])
}

// Color of the yarn
model Color {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  code      String?  // Hex code or color code
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relation to stock lots
  lots      StockLot[]

  @@index([name])
}

// Supplier information
model Supplier {
  id            Int      @id @default(autoincrement())
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  taxId         String?  // For tax purposes
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  purchaseLots  StockLot[] @relation("PurchaseLots")

  @@index([name])
}

// Stock Lot - represents a specific batch/lot of yarn with full traceability
model StockLot {
  id                 Int      @id @default(autoincrement())
  lotNumber          String   @unique // Unique lot identifier
  yarnTypeId         Int
  yarnCountId        Int
  colorId            Int
  netWeight          Float    // Net weight in kg
  grossWeight        Float    // Gross weight in kg (including packaging)
  quantity           Int      // Number of packages/bales, if applicable
  unitOfMeasurement  String   // e.g., "kg", "bales", "pieces"
  purchaseCost       Decimal  // Total purchase cost for this lot
  sellingPrice       Decimal? // Suggested selling price (can be null if not set)
  purchaseDate       DateTime
  manufacturingDate  DateTime? // If applicable
  expiryDate         DateTime? // For perishable yarns
  warehouseLocation  String?  // Warehouse/bin location
  currentStatus      String   @default("IN_STOCK") // IN_STOCK, SOLD, RESERVED, IN_TRANSIT, DAMAGED
  notes              String?  // Any additional notes
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  yarnType    YarnType    @relation(fields: [yarnTypeId], references: [id])
  yarnCount   YarnCount   @relation(fields: [yarnCountId], references: [id])
  color       Color       @relation(fields: [colorId], references: [id])
  supplier    Supplier?   @relation("PurchaseLots", fields: [supplierId], references: [id])
  supplierId  Int?

  // Stock movements tracking
  movements   StockMovement[] @relation("LotMovements")
  saleItems   SaleItem[] @relation("SaleItemLot")

  @@index([lotNumber])
  @@index([yarnTypeId, yarnCountId, colorId])
  @@index([currentStatus])
  @@index([purchaseDate])
}

// Stock Movement - tracks every movement of stock (in/out/adjustment)
model StockMovement {
  id           Int      @id @default(autoincrement())
  lotId        Int
  movementType String   // IN (purchase/production), OUT (sale/consignment), ADJUSTMENT, TRANSFER
  quantity     Float    // Quantity moved (in kg or units)
  referenceId  String?  // Reference to related document (purchase order, sales invoice, etc.)
  referenceType String? // e.g., "PURCHASE", "SALE", "ADJUSTMENT"
  movementDate DateTime @default(now())
  notes        String?
  createdAt    DateTime @default(now())

  // Relations
  lot          StockLot @relation("LotMovements", fields: [lotId], references: [id])

  @@index([lotId])
  @@index([movementType])
  @@index([movementDate])
  @@index([referenceType, referenceId])
}

// Customer information
model Customer {
  id           Int      @id @default(autoincrement())
  name         String
  contactPerson String?
  email        String?
  phone        String?
  address      String?
  taxId        String?  // For tax purposes
  creditLimit  Decimal? // Credit limit for the customer
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  sales        Sale[]   @relation("CustomerSales")

  @@index([name])
}

// Sale / Invoice
model Sale {
  id            Int      @id @default(autoincrement())
  invoiceNumber String   @unique // Invoice number
  customerId    Int
  saleDate      DateTime @default(now())
  dueDate       DateTime? // Payment due date
  totalAmount   Decimal  // Total invoice amount
  status        String   @default("PENDING") // PENDING, PAID, PARTIAL, OVERDUE, CANCELLED
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  customer    Customer @relation("CustomerSales", fields: [customerId], references: [id])
  items       SaleItem[] @relation("SaleItems")

  @@index([invoiceNumber])
  @@index([customerId])
  @@index([saleDate])
  @@index([status])
}

// Sale Item - line items in a sale/invoice
model SaleItem {
  id         Int      @id @default(autoincrement())
  saleId     Int
  lotId      Int      // Which stock lot was sold
  quantity   Float    // Quantity sold (in kg or units)
  unitPrice  Decimal  // Price per unit
  totalPrice Decimal  // Quantity * unitPrice
  notes      String?

  // Relations
  sale   Sale @relation("SaleItems", fields: [saleId], references: [id])
  lot    StockLot @relation("SaleItemLot", fields: [lotId], references: [id])

  @@index([saleId])
  @@index([lotId])
}
